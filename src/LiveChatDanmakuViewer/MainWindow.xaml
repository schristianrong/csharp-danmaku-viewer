<Window x:Class="LiveChatDanmakuViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Live Chat Danmaku Viewer"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        FontFamily="Bahnschrift"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#07131C" Offset="0" />
                <GradientStop Color="#10242E" Offset="0.55" />
                <GradientStop Color="#162B2A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Resources>
            <SolidColorBrush x:Key="AccentBrush" Color="#1BC79D" />
            <SolidColorBrush x:Key="MutedBrush" Color="#93A6B6" />
            <SolidColorBrush x:Key="TextBrush" Color="#F2F6FA" />
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#0B141C" />
                <Setter Property="BorderBrush" Value="#2A3A4A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#0B141C" />
                <Setter Property="BorderBrush" Value="#2A3A4A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="MainBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" />

                                <ToggleButton Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press" />

                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      RecognizesAccessKey="True" />

                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource MutedBrush}"
                                          Data="M 0 0 L 8 0 L 4 5 Z" />
                                </Grid>

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Margin="0,6,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Background="#0B141C"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer CanContentScroll="True"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MainBorder" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Background" Value="#0B141C" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center" />
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1C2A35" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#223545" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#051018" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#12202B" />
                <Setter Property="BorderBrush" Value="#2F4353" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="WrapTableTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="24"
                    CornerRadius="28"
                    Background="#101A23"
                    BorderThickness="1"
                    BorderBrush="#243545">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Danmaku Deck" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="先把 B 站、斗鱼和虎牙三条高频链路打通，实时把弹幕往桌面上拽。协议层和 UI 是分开的，后面要补平台，别再重造轮子。" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="平台" />
                        <ComboBox Margin="0,8,0,0"
                                  ItemsSource="{Binding Platforms}"
                                  SelectedItem="{Binding SelectedPlatform}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanEditSettings}" />

                        <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="房间号" />
                        <TextBox Margin="0,8,0,0"
                                 Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSettings}" />

                        <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="Cookie（可选）" />
                        <TextBox Margin="0,8,0,0"
                                 Height="118"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Text="{Binding Cookie, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditSettings}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanConnect}"
                                    Click="ConnectButton_OnClick"
                                    Content="连接直播间" />
                            <Button Margin="10,0,0,0"
                                    Style="{StaticResource GhostButtonStyle}"
                                    IsEnabled="{Binding CanDisconnect}"
                                    Click="DisconnectButton_OnClick"
                                    Content="断开连接" />
                        </WrapPanel>
                        <Button Margin="0,10,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ClearButton_OnClick"
                                Content="清空消息和日志" />
                        <CheckBox Margin="0,12,0,0"
                                  IsChecked="{Binding EnableAsciiArt}"
                                  Content="字符画模式（ASCII Art）"
                                  ToolTip="开启后，弹幕内容会转成字符画展示。高频场景会增加一些 UI 开销。" />
                    </StackPanel>

                    <Border Grid.Row="6"
                            Padding="18"
                            CornerRadius="22"
                            Background="#0B141C"
                            BorderThickness="1"
                            BorderBrush="#243646">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="当前状态" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding StatusText}" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding StatusDetail}" />

                            <Border Margin="0,18,0,0"
                                    Padding="14"
                                    CornerRadius="16"
                                    Background="#13222C">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="接入说明" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"
                                               Text="支持实时接入：Bilibili、Douyu、Huya" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="协议分析已整理：Douyin、Kuaishou。后续要继续扩平台，保持 IPlatformClient 的隔离边界最省心。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="8"
                            Padding="16"
                            CornerRadius="20"
                            Background="#112733"
                            BorderThickness="1"
                            BorderBrush="#1C4C5D">
                        <TextBlock Foreground="#D6F6EE"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedPlatform.Note}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <Border Padding="24"
                        CornerRadius="28"
                        Background="#101A23"
                        BorderThickness="1"
                        BorderBrush="#243545">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Realtime Stream" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       Text="消息列表按最新在前展示，方便你盯实时弹幕。要扩平台，直接补一个新的 IPlatformClient 就行，UI 这边不用跟着抽风。" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="20,0,0,0"
                                Padding="16,12"
                                CornerRadius="18"
                                Background="#13222B">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Messages" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Text="{Binding MessageCount}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Margin="14,0,0,0"
                                Padding="16,12"
                                CornerRadius="18"
                                Background="#241B14">
                            <StackPanel>
                                <TextBlock Foreground="#F5B07B" FontSize="11" Text="Logs" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#FFF1E7"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Text="{Binding LogCount}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="18"
                        CornerRadius="28"
                        Background="#101A23"
                        BorderThickness="1"
                        BorderBrush="#243545">
                    <DataGrid ItemsSource="{Binding Messages}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#13222C"
                              RowBackground="#0F171F"
                              Foreground="{StaticResource TextBrush}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#13222C" />
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="82"
                                                Header="时间"
                                                Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                            <DataGridTextColumn Width="96"
                                                Header="类型"
                                                Binding="{Binding Category}" />
                            <DataGridTextColumn Width="136"
                                                Header="平台"
                                                Binding="{Binding Platform}" />
                            <DataGridTextColumn Width="86"
                                                Header="房间"
                                                Binding="{Binding RoomId}" />
                            <DataGridTextColumn Width="160"
                                                Header="用户"
                                                Binding="{Binding UserName}" />
                            <DataGridTextColumn Width="120"
                                                Header="粉丝牌"
                                                Binding="{Binding Badge}" />
                            <DataGridTextColumn Width="*"
                                                Header="内容"
                                                Binding="{Binding Content}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WrapTableTextStyle}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="170"
                                                Header="CMD"
                                                Binding="{Binding Command}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="4"
                        Padding="18"
                        CornerRadius="28"
                        Background="#101A23"
                        BorderThickness="1"
                        BorderBrush="#243545">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="Wire Log" />
                            <TextBlock Margin="12,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="协议细节和异常都往这儿落，出问题别靠猜。" />
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Logs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            CornerRadius="16"
                                            Background="#13222C">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Top"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                            <Border Grid.Column="1"
                                                    Width="72"
                                                    Height="24"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="12"
                                                    Background="#233746">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#EAF2F8"
                                                           Text="{Binding Severity}" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Margin="12,0,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Text="{Binding Message}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
